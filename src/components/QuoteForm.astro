---
import { WHATSAPP_NUMBER, TOUR_IDS, TOUR_NAMES } from '../data/site';
import { localize, type Locale } from '../i18n/index';
interface Props { lang:Locale }
const { lang } = Astro.props;
const t = (en:string,ja:string) => localize(lang,{en,ja});
---
<form class="quote-form" action={`https://wa.me/${WHATSAPP_NUMBER}`} method="get" target="_blank" rel="noopener noreferrer">
  <input type="hidden" name="text" id="quote-message" value={t('Hello Yūgana Bari-kun! I would like a quote. My preferred tour, date, guests and pickup area are:','Yūgana Bari-kun様、旅行日、人数、ホテルエリアとご希望のツアーについて相談したいです。')} />
  <div class="form-intro"><h3>{t('A few details, a better plan.','旅のご希望をお聞かせください。')}</h3><p>{t('Add what you know. You can discuss the rest in WhatsApp.','決まっていることだけで大丈夫です。詳細はWhatsAppでご相談いただけます。')}</p></div>
  <div class="form-grid">
    <div class="field"><label for="quote-tour">{t('Your tour idea','ご希望のツアー')}</label><select id="quote-tour"><option value="general">{t('Help me choose','相談して決めたい')}</option>{TOUR_IDS.map(id=><option value={id}>{TOUR_NAMES[lang][id]}</option>)}</select></div>
    <div class="field"><label for="quote-date">{t('Travel date (if known)','ご希望日（未定でも可）')}</label><input id="quote-date" type="date" /></div>
    <div class="field"><label for="quote-adults">{t('Adults','大人の人数')}</label><input id="quote-adults" type="number" min="1" max="30" value="2" inputmode="numeric" required /></div>
    <div class="field"><label for="quote-children">{t('Children','お子さまの人数')}</label><input id="quote-children" type="number" min="0" max="30" value="0" inputmode="numeric" required /></div>
    <div class="field full"><label for="quote-hotel">{t('Hotel or pickup area (optional)','ホテル名・送迎エリア（任意）')}</label><input id="quote-hotel" type="text" maxlength="160" autocomplete="off" /></div>
    <div class="field full"><label for="quote-notes">{t('Anything else? (optional)','その他のご希望（任意）')}</label><textarea id="quote-notes" rows="3" maxlength="600"></textarea></div>
  </div>
  <button class="button button-wide" type="submit">{t('Continue to WhatsApp ↗','WhatsAppで相談する ↗')}</button>
  <p class="form-note">{t('Opens WhatsApp with your details. Review and send your message there. Sending an inquiry does not confirm a booking.','入力内容を含むWhatsAppの画面が開きます。内容をご確認のうえ送信してください。お問い合わせだけでは予約確定になりません。')}</p>
  <noscript><p>{t('Please add your tour, travel date, guests, and pickup area to the message in WhatsApp.','WhatsAppのメッセージに、ご希望のツアー、旅行日、人数、送迎エリアをご記入ください。')}</p></noscript>
</form>
