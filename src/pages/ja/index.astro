---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeContent from '../../components/HomeContent.astro';
import { BRAND } from '../../data/site';
const lang = 'ja';
---
<BaseLayout lang={lang} pagePath="/" title={`バリ島観光ツアー・旅のご相談 | ${BRAND}`} description="バリ島のウブド、ウルワツ寺院、ヌサペニダ島の観光ツアーをご紹介。モデルコースを参考に、ご希望の行程や料金をLINE・WhatsAppからご相談いただけます。ガイドの対応言語や含まれるサービスはご予約前にご確認ください。"><HomeContent lang={lang} /></BaseLayout>
